# Copy to .env and fill in. Nothing here is required for `npm run demo`.

# --- Twitch (live / hybrid mode) ---
# Register an app at https://dev.twitch.tv/console/apps
# OAuth Redirect URL must be exactly: http://localhost:3000/auth/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Broadcaster login (lowercase). The OAuth flow must be completed by this account.
TWITCH_CHANNEL=

# --- AI (live mode only; demo/hybrid never call providers) ---
# Select promise extraction provider: openai (default) | deepseek
EXTRACTION_PROVIDER=openai
# DeepSeek is extraction only; optional OpenAI key is still used for microphone transcription.
DEEPSEEK_API_KEY=
# DEEPSEEK_EXTRACT_MODEL=deepseek-flash
OPENAI_API_KEY=
# Optional overrides
# OPENAI_EXTRACT_MODEL=gpt-4.1-mini
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# --- App ---
PORT=3000
# live | demo | hybrid. Auto-detected from keys when unset.
# RECEIPTS_MODE=
# Votes needed before a !paid / !cap majority settles a DUE IOU
VOTE_QUORUM=5
# auto: log promises with confidence >= 0.7 immediately. approval: everything goes to PENDING first.
EXTRACTION_MODE=auto
# Public base URL used in chat replies (ngrok/cloudflared URL when you want !receipts to be clickable)
# PUBLIC_URL=http://localhost:3000
